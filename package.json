{
  "name": "unrincondelencuentro-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.mjs && node scripts/verificar-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "infra:politica": "node scripts/generar-politica-cloudfront.mjs",
    "deploy:s3": "npm run build && sh scripts/deploy-s3.sh"
  },
  "dependencies": {
    "@fontsource/livvic": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
